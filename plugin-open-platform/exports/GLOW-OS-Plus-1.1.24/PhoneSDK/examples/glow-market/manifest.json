      {
        "id": "gm.device-events",
        "minVersion": "1.0"
      },
      {
        "id": "gm.glow-battery",
        "minVersion": "1.0"
      },
      {
        "id": "gm.glow-direction-buttons",
        "minVersion": "1.1"
      },
      {
        "id": "gm.pocket-fast-frame",
        "minVersion": "1.0"
      },
      {
