{
  "id": "com.example.gemini-live-launcher",
  "name": "Gemini Live Launcher",
  "version": "1.2.0",
  "entry": "index.html",
  "schemaVersion": 2,
  "permissionPolicyVersion": 1,
  "bridgeVersion": "2.0",
  "permissions": [
    {
      "name": "display",
      "required": true
    },
    {
      "name": "device.events",
      "required": true,
      "scope": {
        "types": [
          "button",
          "imuGesture"
        ]
      }
    },
    {
      "name": "network",
      "required": true,
      "reason": "Send authenticated requests to the Android loopback receiver"
    }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.gm.example.web-bridge",
    "protocols": [
      {
        "id": "gm.scene",
        "minVersion": "1.0"
      },
      {
        "id": "gm.device-events",
        "minVersion": "1.0"
      }
    ]
  }
}

